            ],
            "url": {
              "raw": "{{base_url}}/api/commissions/summary/{{period}}",
              "host": ["{{base_url}}"],
              "path": ["api", "commissions", "summary", "{{period}}"]
            },
            "description": "Récupère un résumé des commissions d'une période spécifique (ex: 2024-W01)"
          },
          "response": []
        },
        {
          "name": "Summary by Status",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Summary contains data grouped by status', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data).to.be.an('array');",
                  "    if (jsonData.data.length > 0) {",
                  "        pm.expect(jsonData.data[0]).to.have.property('status');",
                  "        pm.expect(jsonData.data[0]).to.have.property('total');",
                  "        pm.expect(jsonData.data[0]).to.have.property('count');",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/commissions/status/summary",
              "host": ["{{base_url}}"],
              "path": ["api", "commissions", "status", "summary"]
            },
            "description": "Récupère un résumé des commissions groupées par statut (pending, validated, paid, cancelled)"
          },
          "response": []
        },
        {
          "name": "Summary by Type",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Summary contains data grouped by type', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data).to.be.an('array');",
                  "    if (jsonData.data.length > 0) {",
                  "        pm.expect(jsonData.data[0]).to.have.property('type');",
                  "        pm.expect(jsonData.data[0]).to.have.property('total');",
                  "        pm.expect(jsonData.data[0]).to.have.property('count');",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/commissions/type/summary",
              "host": ["{{base_url}}"],
              "path": ["api", "commissions", "type", "summary"]
            },
            "description": "Récupère un résumé des commissions groupées par type (weekly, monthly, special)"
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Bonus Reports",
      "item": [
        {
          "name": "Bonus Report by Type",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Bonus report has expected structure', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('success');",
                  "    pm.expect(jsonData).to.have.property('data');",
                  "    pm.expect(jsonData).to.have.property('total');",
                  "});",
                  "",
                  "pm.test('Each bonus entry has required fields', function () {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.data && jsonData.data.length > 0) {",
                  "        jsonData.data.forEach(function(bonus) {",
                  "            pm.expect(bonus).to.have.property('source');",
                  "            pm.expect(bonus).to.have.property('type');",
                  "            pm.expect(bonus).to.have.property('count');",
                  "            pm.expect(bonus).to.have.property('total');",
                  "        });",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/commissions/report/bonus",
              "host": ["{{base_url}}"],
              "path": ["api", "commissions", "report", "bonus"]
            },
            "description": "Rapport détaillé des bonus par type avec totaux et comptage"
          },
          "response": []
        }
      ]
    },
