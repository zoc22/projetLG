    {
      "name": "5. Gestion des Permissions",
      "item": [
        {
          "name": "Vérifier une permission",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"permission\": \"users.view\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/core/permissions/check",
              "host": ["{{base_url}}"],
              "path": ["api", "core", "permissions", "check"]
            },
            "description": "Vérifie si l'utilisateur authentifié a une permission spécifique"
          },
          "response": []
        },
        {
          "name": "Vérifier TOUTES les permissions",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"permissions\": [\"users.view\", \"users.create\", \"users.edit\"]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/core/permissions/check-all",
              "host": ["{{base_url}}"],
              "path": ["api", "core", "permissions", "check-all"]
            },
            "description": "Vérifie si l'utilisateur a TOUTES les permissions spécifiées"
          },
          "response": []
        },
        {
          "name": "Vérifier AU MOINS UNE permission",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"permissions\": [\"users.delete\", \"admin\", \"super_admin\"]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/core/permissions/check-any",
              "host": ["{{base_url}}"],
              "path": ["api", "core", "permissions", "check-any"]
            },
            "description": "Vérifie si l'utilisateur a AU MOINS UNE des permissions spécifiées"
          },
          "response": []
        },
