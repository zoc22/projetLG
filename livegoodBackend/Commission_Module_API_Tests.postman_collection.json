    {
      "name": "5. Data Validation Tests",
      "item": [
        {
          "name": "Validate Commission Amount Format",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Commission amounts are numbers', function () {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.data && jsonData.data.length > 0) {",
                  "        jsonData.data.forEach(function(commission) {",
                  "            pm.expect(commission.amount).to.be.a('number');",
                  "            pm.expect(commission.amount).to.be.at.least(0);",
                  "        });",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/commissions",
              "host": ["{{base_url}}"],
              "path": ["api", "commissions"]
            },
            "description": "Validation que les montants de commission sont des nombres valides"
          },
          "response": []
        },
