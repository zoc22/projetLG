    {
      "name": "6. Business Logic Tests",
      "item": [
        {
          "name": "Verify User Isolation",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('User can only see their own commissions', function () {",
                  "    var jsonData = pm.response.json();",
                  "    var currentUserId = pm.environment.get('user_id');",
                  "    if (jsonData.data && jsonData.data.length > 0) {",
                  "        jsonData.data.forEach(function(commission) {",
                  "            pm.expect(commission.user_id).to.equal(currentUserId);",
                  "        });",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/commissions",
