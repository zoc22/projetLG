        {
          "name": "Verify Total Calculations",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Total amount calculation is correct', function () {",
                  "    var jsonData = pm.response.json();",
                  "    var calculatedTotal = 0;",
                  "    if (jsonData.summary && jsonData.summary.length > 0) {",
                  "        jsonData.summary.forEach(function(item) {",
                  "            calculatedTotal += item.total || 0;",
                  "        });",
                  "        pm.expect(calculatedTotal).to.equal(jsonData.total_amount);",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              },
              {
                "key": "Accept",
