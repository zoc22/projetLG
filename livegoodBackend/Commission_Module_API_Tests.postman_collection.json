              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/commissions/status/summary",
              "host": ["{{base_url}}"],
              "path": ["api", "commissions", "status", "summary"]
            },
            "description": "Validation que les statuts sont parmi: pending, validated, paid, cancelled"
          },
          "response": []
